.qm-list-wrap
  max-height calc(100vh - 100px)
  overflow-y scroll
  padding 20px 0 10px 0
.qm-wrap-tooltip
  background var(--main)
  position absolute
  left 43px
  right 0
  z-index 89
  height auto
  bottom 36px

.qm-pinned
  .qm-wrap-tooltip
    height 180px
  .qm-list-wrap
    max-height 100px

.qm-search-input
  max-width 200px
@media (max-width: 500px)
  .qm-search-input
    width 100px

.item-list-unit.dragover
  border: 1px dashed var(--primary)
.qm-item-dragover
  border-left 2px solid var(--primary)
.qm-field-dragging
  opacity 0.4
.qm-field-dragover
  border-top 2px solid var(--primary)
.qm-label-select
  min-width 120px
.qm-action-select
  min-width 130px

.qm-flex
  gap 8px

.macros-settings
  .setting-row-left
    padding-top 12px
    border-right 1px solid var(--main-light)
  .item-list
    height 100%
    display flex
    flex-direction column
  .item-list-wrap
    flex 1
  .item-list-unit
    min-height 38px
    margin-bottom 3px
    border-radius 5px
  .item-list-unit.active
    box-shadow inset 3px 0 var(--primary-contrast)

.macro-folders
  margin 10px 0 8px
  padding-bottom 10px
  border-bottom 1px solid var(--main-light)
.macro-folders-heading
  padding 0 10px 7px
  color var(--text-light)
  font-size 12px
  font-weight 600
  letter-spacing .06em
  text-transform uppercase
.macro-folder-create
  display flex
  gap 5px
  padding 0 5px 8px
  button
    width 30px
    border 1px solid var(--main-lighter)
    border-radius 4px
    color var(--text)
    background transparent
    cursor pointer
.macro-folder
  width 100%
  height 34px
  padding 0 10px
  border 0
  border-radius 5px
  display flex
  align-items center
  justify-content space-between
  color var(--text)
  background transparent
  cursor pointer
  &:hover
    background var(--hover-bg, rgba(255, 255, 255, .05))
  &.active
    color var(--primary)
    background rgba(0, 136, 204, .16)
.macro-folder-name
  min-width 0
  display flex
  align-items center
  gap 9px
.macro-folder-count
  min-width 24px
  padding 1px 7px
  border-radius 10px
  color var(--text-light)
  background var(--main-light)
  font-size 11px
  text-align center

.macro-editor
  max-width 1100px
  margin 0 auto
.macro-editor-header
  margin: 0 0 22px 16px
  padding-bottom 15px
  border-bottom 1px solid var(--main-light)
  h2
    margin 0 0 3px
    font-size 20px
  p
    margin 0
    color var(--text-light)
.macro-editor
  .ant-space-compact
    padding 8px
    border 1px solid var(--main-lighter)
    border-radius 6px
    background var(--main-light)
  .qm-input
    min-height 34px
  .ant-form-item-label > label
    font-weight 500
.macro-form-create-folder
  display flex
  gap 8px
  margin-top 8px

@media (max-width: 768px)
  .qm-flex
    flex-direction column
    align-items flex-start
  .qm-search-input
    max-width none
    width 100%
  .qm-label-select
    width 100%
